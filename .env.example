API_HOST=127.0.0.1
API_PORT=4000
MODEL_SERVICE_HOST=127.0.0.1
MODEL_SERVICE_PORT=5001
MODEL_SERVICE_URL=http://127.0.0.1:5001

# Browser-facing API base for the website.
# Use /api in local dev so Vite can proxy requests cleanly.
VITE_API_BASE_URL=/api

# Hosted mode. PUBLIC_MODE gives the public site interactive calculations without private data.
DEMO_MODE=false
PUBLIC_MODE=false

# Set to 1 only when the API runs behind a reverse proxy you control, so the rate limiter can trust
# X-Forwarded-For. Vercel is detected automatically. Leave unset when clients connect directly.
TRUST_PROXY=0

# Vite dev server host/port and proxy target.
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Only needed to retrain the Vancouver bundle offline (scripts/train_model_bundles.py).
VANCOUVER_LISTINGS_CSV_PATH=/absolute/path/to/data_bc.csv
